[TEMPLATE]
# Copy to .env and replace every value before running `npm run server`.
# .env is gitignored. Never commit real values.

# --- Core ---
PORT=4000
# Public origin of the site. Used for OAuth redirects and canonical links.
APP_URL=http://localhost:5173
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-characters
ADMIN_EMAIL=organizer@example.com
ADMIN_PASSWORD=replace-with-a-strong-local-password

# --- Database ---
# PostgreSQL is used whenever DATABASE_URL is set. If it is missing, the API
# falls back to the SQLite file below (local development only).
# DATABASE_URL=postgres://forge:password@127.0.0.1:54329/unstableforge

# Where uploaded event photographs are written. Point this at durable storage in
# production; the default is a local folder that a redeploy would replace.
# MEDIA_DIR=./server/data/uploads
# PGSSLMODE=require
# PGPOOL_MAX=10
DATABASE_PATH=server/data/unstable-forge.db

# --- Google sign-in ---
# Both values come from a Google Cloud OAuth 2.0 Web application client.
# The button stays hidden until both are set. See docs/GOOGLE_OAUTH_SETUP.md.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost:5173/api/auth/google/callback

# --- Abuse protection ---
AUTH_RATE_MAX=60

# --- Uploads (planned; local disk is not persistent in production) ---
# UPLOAD_DRIVER=local
# UPLOAD_DIR=server/data/uploads

# --- Email delivery (verification + password reset) ---
# Create a Resend account, verify a sending domain, then set both values.
# Without them the API reports EMAIL_NOT_CONFIGURED and never claims a mail was sent.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# EMAIL_FROM=Unstable Forge <no-reply@your-verified-domain.com>

# --- Payments (Razorpay) ---
# Keys come from the Razorpay dashboard. Start with test-mode keys (rzp_test_...).
# The webhook secret is set when the webhook endpoint is created in Razorpay.
# Webhook URL: https://your-domain/api/payments/razorpay/webhook
# Events to subscribe: payment.captured, payment.authorized, payment.failed
# payment.authorized matters: it records an uncaptured payment so a second
# checkout cannot be opened for the same seat.
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# --- Manual payment fallback (optional) ---
# UPI_VPA=
# UPI_PAYEE_NAME=
# UPI_QR_IMAGE_PATH=
